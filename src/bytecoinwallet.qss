* {
  font-family: %fontFamily%;
}

QWidget {
  color: %textColor%;
  background-color: transparent;
}

QMainWindow#MainWindow, QDialog {
  background-color: %backgroundColorGray%;
}

QWidget#centralwidget {
  background-color: %backgroundColorGray%;
}

QDialog QLabel {
  background-color: transparent;
}

QTextEdit {
  border-radius: 8px;
  border: 1px solid %borderColorDark%;
}

QMenuBar {
  background-color: %headerBackgroundColor%;
  border-bottom: 1px solid %headerBorderColor%;
  padding: 4px 8px;
}

QMenuBar::item {
  background: transparent;
  border-radius: 6px;
  padding: 7px 11px;
}

QMenuBar::item:selected,
QMenu::item:selected {
  background-color: %surfaceHoverColor%;
  color: %textColor%;
}

QMenu {
  background-color: %elevatedSurfaceColor%;
  border: 1px solid %borderColorDark%;
  border-radius: 8px;
  padding: 6px;
}

QMenu::item {
  padding: 8px 24px 8px 12px;
  border-radius: 5px;
}

QMenu::separator {
  height: 1px;
  background-color: %borderColor%;
  margin: 5px 8px;
}

QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox, QPushButton, QDateTimeEdit, QRadioButton, QCheckBox {
  font-size: %fontSizeNormal%;
  border-radius: 7px;
  min-height: 34px;
  border: 1px solid %borderColorDark%;
}

QLineEdit, QTextEdit, QPlainTextEdit, QDoubleSpinBox, QSpinBox, QComboBox, QDateTimeEdit {
  background-color: %elevatedSurfaceColor%;
  padding-left: 10px;
  selection-background-color: %selectionColor%;
  selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus, QDateTimeEdit:focus {
  border: 1px solid %backgroundColorBlueNormal%;
}

QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled,
QDoubleSpinBox:disabled, QSpinBox:disabled, QPushButton:disabled {
  color: %disabledTextColor%;
  background-color: %backgroundColorGray%;
  border-color: %borderColor%;
}

QPushButton {
  background-color: %elevatedSurfaceColor%;
  border-color: %borderColorDark%;
  padding: 6px 14px;
}

QPushButton:hover {
  background-color: %surfaceHoverColor%;
  border-color: %backgroundColorBlueNormal%;
}

QPushButton:pressed {
  background-color: %toolButtonBackgroundColorPressed%;
}

QPushButton:focus {
  border: 1px solid %backgroundColorBlueNormal%;
}

#m_sendFrame QPushButton#m_sendButton {
  color: #FFFFFF;
  background-color: %backgroundColorBlueNormal%;
  border: 1px solid %backgroundColorBlueNormal%;
  border-radius: 9px;
  font-weight: 600;
  min-height: 42px;
  padding-left: 20px;
  padding-right: 20px;
}

#m_sendFrame QPushButton#m_sendButton:hover {
  background-color: %backgroundColorBlueHover%;
  border-color: %backgroundColorBlueHover%;
}

#m_sendFrame QPushButton#m_sendButton:pressed {
  background-color: %backgroundColorBluePressed%;
  border-color: %backgroundColorBluePressed%;
}

#MyAddressesFrame #m_addAddressButton {
  color: #FFFFFF;
  background-color: %backgroundColorBlueNormal%;
  border: 1px solid %backgroundColorBlueNormal%;
  border-radius: 9px;
  font-weight: 600;
  min-height: 42px;
  padding: 6px 18px;
}

#MyAddressesFrame #m_addAddressButton:hover {
  background-color: %backgroundColorBlueHover%;
  border-color: %backgroundColorBlueHover%;
}

#MyAddressesFrame #m_addressFormatHint {
  color: %mutedTextColor%;
  font-size: %fontSizeSmall%;
  padding-left: 4px;
}

#MyAddressesFrame #m_addressFormatValue {
  min-height: 36px;
  padding: 0 12px;
  color: %textColor%;
  background-color: %elevatedSurfaceColor%;
  border: 1px solid %borderColorDark%;
  border-radius: 7px;
}

#MyAddressesFrame QTreeView {
  outline: none;
  show-decoration-selected: 0;
}

#MyAddressesFrame QTreeView::item {
  min-height: 40px;
  padding-top: 3px;
  padding-bottom: 3px;
}

#m_sendRecipientHeader,
#m_sendFeeFrame,
#m_mixinFrame {
  background-color: %surfaceColor%;
  border: 1px solid %borderColor%;
  border-radius: 12px;
}

#m_sendRecipientHeader {
  background-color: %elevatedSurfaceColor%;
}

#m_sendSectionTitle {
  color: %textColor%;
  font-size: %fontSizeLarge%;
  font-weight: 600;
}

#m_sendSectionHint {
  color: %mutedTextColor%;
  font-size: %fontSizeSmall%;
}

#m_sendAvailableBalance {
  color: %textColor%;
  font-size: %fontSizeSmall%;
  font-weight: 600;
}

#m_sendRecipientHeader QPushButton {
  min-height: 38px;
  padding: 4px 11px;
}

#m_sendRecipientHeader QPushButton[sendAction="primary"] {
  color: #FFFFFF;
  background-color: %backgroundColorBlueNormal%;
  border-color: %backgroundColorBlueNormal%;
  font-weight: 600;
}

#m_sendRecipientHeader QPushButton[sendAction="primary"]:hover {
  background-color: %backgroundColorBlueHover%;
  border-color: %backgroundColorBlueHover%;
}

QFrame#TransferFrame {
  background-color: %elevatedSurfaceColor%;
  border: 1px solid %borderColor%;
  border-radius: 10px;
}

QFrame#TransferFrame QLabel {
  color: %mutedTextColor%;
}

QFrame#TransferFrame QPushButton {
  min-height: 32px;
  padding: 3px 10px;
}

QFrame#TransferFrame QPushButton[sendAction="destructive"] {
  color: #FF9AA7;
  background-color: transparent;
  border-color: transparent;
}

QFrame#TransferFrame QPushButton[sendAction="destructive"]:hover {
  color: #FFFFFF;
  background-color: #65303B;
  border-color: #8B3C4C;
}

#m_sendFeeFrame {
  padding: 2px;
}

#m_sendFeeFrame QLabel,
#m_mixinFrame QLabel#m_sendTotalCaption {
  color: %mutedTextColor%;
}

#m_mixinFrame QLabel#m_sendTotalAmount {
  color: %textColor%;
  font-size: %fontSizeLarge%;
  font-weight: 600;
}

QToolTip {
  color: %textColor%;
  background-color: %elevatedSurfaceColor%;
  border: 1px solid %borderColorDark%;
  padding: 5px 8px;
}

QProgressDialog {
  background-color: %backgroundColorGray%;
}

QProgressBar {
  color: %textColor%;
  background-color: %elevatedSurfaceColor%;
  border: 1px solid %borderColorDark%;
  border-radius: 6px;
  min-height: 12px;
  text-align: center;
}

QProgressBar::chunk {
  background-color: %fontColorBlueHover%;
  border-radius: 5px;
}

QTableView, QTreeView, QListView {
  background-color: %surfaceColor%;
  alternate-background-color: %elevatedSurfaceColor%;
  border: 1px solid %borderColor%;
  border-radius: 8px;
  gridline-color: %borderColor%;
  selection-background-color: %selectionColor%;
  selection-color: #ffffff;
  outline: none;
}

QHeaderView::section {
  color: %mutedTextColor%;
  background-color: %elevatedSurfaceColor%;
  border: none;
  border-bottom: 1px solid %borderColor%;
  padding: 9px 10px;
  font-weight: 600;
}

QRadioButton, QCheckBox {
  border: none;
}

QDateTimeEdit {
  border: 1px solid %borderColorDark%;
  background-color: transparent;
  min-width: 155px;
  max-width: 155px;
  font-size: %fontSizeNormal%;
  padding-left: 10px;
  selection-background-color: %borderColor%;
  selection-color: %textColor%;
}


QDateTimeEdit::drop-down {
  width: 20;
  border-top-right-radius: 2px;
  border-bottom-right-radius: 2px;
  border-color: %borderColorDark%;
  image: url(:icons/down-arrow);
}

QMessageBox QLabel {
  font-size: %fontSizeLarge%;
}

QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox, QDateTimeEdit {
  padding-left: 5px;
}


QComboBox {
  border: 1px solid %borderColorDark%;
  background-color: transparent;
  font-size: %fontSizeNormal%;
  padding-left: 10px;
  selection-background-color: %selectionColor%;
  selection-color: #ffffff;
}

QComboBox::drop-down {
  width: 20;
  border-top-right-radius: 2px;
  border-bottom-right-radius: 2px;
  border-color: %borderColorDark%;
  image: url(:icons/down-arrow);
}

QComboBox QAbstractItemView {
  border: 1px solid %borderColorDark%;
  border-radius: 2px;
}

QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button,
QSpinBox::up-button,
QSpinBox::down-button,
QTimeEdit::up-button,
QTimeEdit::down-button {
  border-width: 1px;
  padding-right: 5px;
}

QDoubleSpinBox::up-arrow,
QSpinBox::up-arrow,
QTimeEdit::up-arrow{
  image: url(:icons/up-arrow);
}

QDoubleSpinBox::down-arrow,
QSpinBox::down-arrow,
QTimeEdit::down-arrow{
  image: url(:icons/down-arrow);
}

QScrollBar:vertical {
  max-width: 6px;
  background: %scrollTrackColor%;
  margin-top: 20px;
  border-top: 1px solid %borderColor%;
}

QScrollBar::handle:vertical {
  background-color: %backgroundColorBlueNormal%;
  min-height: 20px;
}

QCalendarWidget QMenu {
  border: 1px solid %borderColorDark%;
  border-radius: 2px;
  background-color: %elevatedSurfaceColor%;
  selection-background-color: %selectionColor%;
  selection-color: #ffffff;
}

QScrollBar::sub-line, QScrollBar::add-line {
  width: 0px;
  height: 0px;
}

QSlider {
  margin-right: 1px;
  height: 16px;
}

QSlider::groove:horizontal {
  height: 5px;
  background-color: transparent;
  border: 1px solid %borderColorDark%;
  border-radius: 3px
}

QSlider::handle:horizontal {
  margin: -5px -2px;
  image: url(:icons/slider-handle);
}

QSlider::sub-page:horizontal:enabled {
  background-color: %backgroundColorBlueNormal%;
  border: 1px solid %backgroundColorBlueNormal%;
  border-radius: 3px
}

QSlider::sub-page:horizontal:!enabled {
  background-color: %borderColorDark%;
  border: 1px solid %borderColorDark%;
}

QSlider::add-page:horizontal {
  border-radius: 3px
}

QCalendarWidget #qt_calendar_navigationbar {
  min-height: 27px;
  background-color: %elevatedSurfaceColor%;
}
QCalendarWidget QAbstractItemView {
  selection-background-color: %selectionColor%;
  selection-color: #ffffff;
}

QCalendarWidget {
  leftarrow-icon: url(:icons/arrow-left-black);
  rightarrow-icon: url(:icons/arrow-right-black);
}

QCalendarWidget QToolButton {
  border: none;
}

QCalendarWidget QToolButton::menu-indicator {
  image: none;
}

QCalendarWidget QToolButton:hover {
  background-color: %surfaceHoverColor%;
}


QCalendarWidget QSpinBox {
  border-radius: 2px;
  min-height: 25px;
  max-height: 25px;
  border: 1px solid %borderColorDark%;
}

#MainWindow > #centralwidget > #m_headerFrame {
  background-color: %headerBackgroundColor%;
  border: none;
  border-bottom: 1px solid %headerBorderColor%;
  min-height: 116px;
  max-height: 116px;
}

#MainWindow > #centralwidget {
  background-color: %backgroundColorGray%;
}

#MainWindow > #centralwidget > #m_headerFrame #m_logoLabel {
  background-color: transparent;
}

#MainWindow > #centralwidget > #m_headerFrame #m_walletStatusLabel {
  color: %fontColorBlueHover%;
  font-weight: 600;
}

#MainWindow > #centralwidget > #m_headerFrame #m_walletViewOnlyLabel {
  color: %fontColorBlueHover%;
  background-color: %toolButtonBackgroundColorPressed%;
  border: 1px solid %borderColor%;
  border-radius: 9px;
  padding: 4px 10px;
}

#MainWindow > #centralwidget > #m_headerFrame #m_balanceTextLabel {
  font-size: %fontSizeLarge%;
  font-weight: bold;
  color: %balanceFontColor%;
}

#MainWindow > #centralwidget > #m_headerFrame #m_balanceLabel {
  font-size: %fontSizeDisplay%;
  font-weight: 700;
  color: %balanceFontColor%;
}

#MainWindow > #centralwidget > #m_headerFrame #m_balanceLabelText,
#MainWindow > #centralwidget > #m_headerFrame #m_addressLabelText,
#MainWindow > #centralwidget > #m_headerFrame #m_topBlockLabel {
  color: %mutedTextColor%;
}

#m_balanceOverviewFrame {
  border: 1px solid %borderColorDark%;
  border-radius: 12px;
  background-color: %surfaceColor%;
}

#OverviewFrame,
#m_sendFrame,
#m_addressBookFrame,
#m_myAddressesFrame,
#m_logFrame {
  background-color: %backgroundColorGray%;
  border: none;
}

#m_walletHealthFrame {
  border: 1px solid %borderColor%;
  border-radius: 10px;
  background-color: %elevatedSurfaceColor%;
}

#m_walletHealthFrame QLabel {
  background-color: transparent;
}

#m_walletHealthTitle {
  color: %fontColorBlueHover%;
  font-size: %fontSizeSmall%;
  letter-spacing: 1px;
}

#m_balanceOverviewFrame #m_titleLabel {
  font-size: %fontSizeLarge%;
  font-weight: bold;
}

#m_balanceOverviewFrame #m_overviewSpendableBalanceLabel,
#m_balanceOverviewFrame #m_overviewLockedOrUnconfirmedBalanceLabel,
#m_balanceOverviewFrame #m_overviewTotalBalanceLabel {
  font-weight: bold;
}

#m_balanceOverviewFrame #m_overviewSpendableBalanceTextLabel,
#m_balanceOverviewFrame #m_overviewLockedOrUnconfirmedBalanceTextLabel,
#m_balanceOverviewFrame #m_overviewTotalBalanceTextLabel {
  color: %mutedTextColor%;
}

#MainWindow > #centralwidget > #m_headerFrame > #m_walletFrame > #m_addressLabel {
  font-size: %fontSizeLarge%;
  color: %addressFontColor%;
}

#MainWindow > #centralwidget > #m_headerFrame > #m_walletFrame > #m_copyAddressLabel {
  font-size: %fontSizeTiny%;
  color: %fontColorBlueHover%;
}

#MainWindow > #centralwidget > #m_toolFrame {
  background-color: %toolButtonBackgroundColorNormal%;
  border: none;
  border-right: 1px solid %toolBarBorderColor%;
  min-width: 184px;
  max-width: 184px;
}

#MainWindow > #centralwidget > #m_toolFrame[compact="true"] {
  min-width: 72px;
  max-width: 72px;
}

#MainWindow > #centralwidget > #m_toolFrame > QPushButton {
  min-height: 44px;
  max-height: 44px;
  background-color: transparent;
  border: 1px solid transparent;
  border-left: 3px solid transparent;
  border-radius: 8px;
  color: %toolButtonFontColorNormal%;
  font-size: %fontSizeNormal%;
  font-weight: 500;
  icon-size: 20px 20px;
  padding: 0 12px;
  text-align: left;
}

#MainWindow > #centralwidget > #m_toolFrame > QPushButton:hover {
  background-color: %surfaceHoverColor%;
  border-color: %borderColor%;
}

#MainWindow > #centralwidget > #m_toolFrame > QPushButton:checked {
  background-color: %toolButtonBackgroundColorPressed%;
  border-color: transparent;
  border-left: 3px solid %fontColorBlueHover%;
  color: %textColor%;
  font-weight: 600;
}

#MainWindow > #centralwidget > #m_toolFrame[compact="true"] > QPushButton {
  min-height: 48px;
  max-height: 48px;
  padding: 0;
  text-align: center;
}

#MainWindow > #centralwidget > #m_toolFrame > QPushButton:disabled {
  color: %toolButtonFontColorDisabled%;
}

#MainWindow > #centralwidget > #m_headerFrame > #m_walletFrame > #m_addressLabel {
  font-size: %fontSizeLarge%;
  color: %addressFontColor%;
}

#MainWindow > #centralwidget > #m_syncProgress {
  border-top: 1px solid %borderColor%;
  background-color: %statusBarBackgroundColor%;
  min-height: 5px;
  max-height: 5px;
  border-radius: 0px;
}

#MainWindow > #centralwidget > #m_syncProgress::chunk {
  background-color: %backgroundColorBlueNormal%;
}

#MainWindow > #centralwidget > #m_headerFrame > #m_balanceFrame > #m_balanceCopyLabel {
  font-size: %fontSizeTiny%;
  color: %fontColorBlueHover%;
}


#m_blockExplorerFrame {
  background-color: %backgroundColorGray%;
  border: none;
}

#m_blockchainTab > #m_filterFrame > #m_filterPeriodComboFrame > #m_filterCombo {
  min-width: 100px;
  max-width: 100px;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar > #m_blockchainTab > #m_filterFrame > #m_filterHashFrame > QLineEdit {
  font-size: %fontSizeNormal%;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar {
  border: none;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar::pane {
  border: none;
  border-top: 1px solid %borderColorDark%;
  top: -1px;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar::tab-bar {
  left: 25px;
  alignment: left;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar QTabBar::tab {
  font-size: %fontSizeLarge%;
  font-weight: bold;
  min-width: 200px;
  max-width: 200px;
  min-height: 30px;
  max-height: 30px;
  border: 1px solid %borderColorDark%;
  margin-left: 2px;
  margin-right: 2px;
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar QTabBar::tab:selected {
  background: %elevatedSurfaceColor%;
  border: 1px solid %borderColorDark%;
  border-bottom: 1px solid %elevatedSurfaceColor%;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar QTabBar::tab:!selected {
  background: %backgroundColorGray%;
  border: 1px solid %borderColorDark%;
}

#m_blockchainTab, #m_transactionPoolTab {
  background-color: %surfaceColor%;
  border: none;
}

QTabWidget::pane {
  border: 1px solid %borderColor%;
  border-radius: 8px;
  top: -1px;
}

QTabBar::tab {
  color: %mutedTextColor%;
  background-color: %backgroundColorGray%;
  border: 1px solid transparent;
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
  padding: 8px 14px;
  margin-right: 3px;
}

QTabBar::tab:selected {
  color: %textColor%;
  background-color: %surfaceColor%;
  border-color: %borderColor%;
  border-bottom-color: %surfaceColor%;
}

QTabBar::tab:hover:!selected {
  color: %textColor%;
  background-color: %surfaceHoverColor%;
}

#m_recentTransactionsView {
  border-radius: 10px;
}

#m_recentTransactionsView::item {
  min-height: 34px;
  padding-left: 8px;
  padding-right: 8px;
}

#m_logFrame QTextEdit {
  background-color: #11141D;
  color: #DCE2EC;
  border: 1px solid #292D39;
  border-radius: 10px;
  padding: 12px;
  selection-background-color: #69364F;
  selection-color: #FFFFFF;
}

#m_logFrame QPushButton {
  min-height: 36px;
  padding: 0 16px;
  border-radius: 8px;
  background-color: #242833;
  border: 1px solid #383D4B;
  color: #E6E8EF;
}

#m_logFrame QPushButton:hover {
  background-color: #303643;
  border-color: #FF6AA8;
}

QStatusBar {
  color: %mutedTextColor%;
  background-color: %statusBarBackgroundColor%;
  border-top: 1px solid %borderColor%;
}

QStatusBar QLabel {
  color: %mutedTextColor%;
  background-color: transparent;
}

#m_addressBookFrame {
  background-color: %surfaceColor%;
  border: none;
}

#m_addressBookMenuButton {
  min-height: 46px;
  background-color: transparent;
  border: none;
  image: url(:icons/big-down-arrow);
}

#m_addressBookMenuButton:hover {
  image: url(:icons/big-down-arrow-black);
}

#m_addressBookMenuButton:!hover {
  image: url(:icons/big-down-arrow);
}

#m_addressBookMenuButton::menu-indicator {
  image: none;
}

#m_addressBookMenu {
  border: 1px solid %borderColorDark%;
  border-radius: 2px;
  background-color: %elevatedSurfaceColor%;
  selection-background-color: %selectionColor%;
  selection-color: #ffffff;
}

#AddressBookDialog {
  background-color: %surfaceColor%;
}

#m_noWalletFrame {
  background-color: %surfaceColor%;
}


#m_passwordFrame > QLabel,
#ChangePasswordDialog > QLabel,
#NewPasswordDialog > QLabel {
  font-size: %fontSizeNormal%;
  color: %fontColorGray%;
}

#m_passwordFrame > #m_walletNameLabel {
  font-weight: bold;
  color: %textColor%;
}


QMessageBox > QDialogButtonBox > QPushButton {
  min-width: 80px;
  max-width: 80px;
  min-height: 30px;
  max-height: 30px;
  font-size: %fontSizeNormal%;
  color: #ffffff;
  background-color: %backgroundColorBlueNormal%;
  border: 1px solid %backgroundColorBlueNormal%;
}


QMessageBox > QDialogButtonBox > QPushButton:hover {
  background-color: %backgroundColorBlueHover%;
  border: 1px solid %backgroundColorBlueHover%;
}

QMessageBox > QDialogButtonBox > QPushButton:pressed {
  background-color: %backgroundColorBluePressed%;
  border: 1px solid %backgroundColorBluePressed%;
}

#newTransactionLabel {
  background-color: %warningSurfaceColor%;
}

#P2pBindPortErrorDialog > QSpinBox {
  min-height: 25px;
  max-height: 25px;
}
